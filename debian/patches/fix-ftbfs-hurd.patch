From: Alberto Garcia <berto@igalia.com>
Subject: Fix FTBTS in the Hurd
Forwarded: no
Index: webkitgtk/Source/WTF/wtf/generic/MemoryFootprintGeneric.cpp
===================================================================
--- webkitgtk.orig/Source/WTF/wtf/generic/MemoryFootprintGeneric.cpp
+++ webkitgtk/Source/WTF/wtf/generic/MemoryFootprintGeneric.cpp
@@ -33,8 +33,12 @@ namespace WTF {
 
 size_t memoryFootprint()
 {
+#if OS(HURD)
+    return 0;
+#else
     auto memoryUse = memoryStatus();
     return memoryUse.memoryFootprint;
+#endif
 }
 
 } // namespace WTF
Index: webkitgtk/Source/WTF/wtf/InlineASM.h
===================================================================
--- webkitgtk.orig/Source/WTF/wtf/InlineASM.h
+++ webkitgtk/Source/WTF/wtf/InlineASM.h
@@ -43,7 +43,7 @@
 #define THUMB_FUNC_PARAM(name)
 #endif
 
-#if (OS(LINUX) || OS(FREEBSD) || OS(HAIKU) || OS(QNX)) && CPU(X86_64)
+#if (OS(LINUX) || OS(FREEBSD) || OS(HAIKU) || OS(HURD) || OS(QNX)) && CPU(X86_64)
 #define GLOBAL_REFERENCE(name) #name "@plt"
 #elif OS(LINUX) && CPU(X86) && defined(__PIC__)
 #define GLOBAL_REFERENCE(name) SYMBOL_STRING(name) "@plt"
@@ -68,6 +68,7 @@
     || OS(FUCHSIA)             \
     || OS(HAIKU)               \
